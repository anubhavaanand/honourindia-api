{
  "name": "honourindia",
  "version": "0.1.0",
  "private": true,
  "description": "A billboard network for the minds that built India — an embeddable widget + public API honouring Indian scientists and great minds.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w packages/embed && npm run dev -w apps/server",
    "start": "npm run start -w apps/server",
    "build": "npm run build -w packages/embed && npm run build -w apps/server",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "deploy:pages": "npm run build:pages && node scripts/deploy-pages.mjs",
    "seed:images": "node scripts/fetch-images.mjs",
    "issue-key": "node scripts/issue-key.mjs",
    "research:wikidata": "node scripts/research-wikidata.mjs",
    "dedup:figures": "node scripts/dedup-figures.mjs",
    "clean:orphan-images": "node scripts/clean-orphan-images.mjs",
    "clean:orphan-images:delete": "node scripts/clean-orphan-images.mjs --delete",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:data:fix": "node scripts/validate-data.mjs --fix",
    "check:size": "node scripts/check-bundle-size.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md,yml,yaml}\"",
    "import:candidates": "node scripts/import-candidates.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.0.0"
  }
}
