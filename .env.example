# Copy to .env and adjust as needed.

# Port the HTTP server listens on (default: 3000).
PORT=3000

# Optional. Set to "production" to serve /embed.js and site assets with long
# cache lifetimes. Any other value (including unset) is treated as development.
# NODE_ENV=production

# Optional. Lowest log level the server writes: debug, info, warn, error.
# LOG_LEVEL=info

# Optional. "json" (the default in production) or "pretty" for a readable line.
# LOG_FORMAT=json

# Set to "1" only when the server sits behind a trusted reverse proxy that sets
# X-Forwarded-For / X-Real-IP. When unset, those headers are ignored and the
# socket address is used, so clients cannot spoof their IP to evade rate limits.
# TRUST_PROXY=1

# Required in production. Admin key for the moderation endpoints
# (/api/v1/admin/*). There is no usable default: when unset, admin routes reject
# every request rather than accept a shared development key.
# ADMIN_KEY=change-me-to-a-long-random-string